\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {Heartbeat optimisation.} Blue = average lifetime $\bar  T_{\text  {all}}$ (left axis); red = average orphan ticks (right axis -- the cumulative ticks a follower waits without a leader before the next heartbeat-triggered election). Both objectives are read from one chart: lifetime should be as high as possible, orphan-ticks as low as possible. The lifetime curve has a sharp knee at $h\!\approx \!15$--$20$: from $h{=}1$ to $h{=}16$ lifetime jumps roughly $+240$ ticks; from $h{=}16$ to $h{=}150$ it gains only $\sim \!50$ more, while the worst-case failure-detection delay scales linearly with $h$. We therefore choose $h^\ast =15$: it captures $\sim \!95\%$ of the achievable lifetime while keeping the orphan window bounded at $\le 15$ ticks.}}{2}{figure.caption.5}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:heartbeat}{{1}{2}{\textbf {Heartbeat optimisation.} Blue = average lifetime $\bar T_{\text {all}}$ (left axis); red = average orphan ticks (right axis -- the cumulative ticks a follower waits without a leader before the next heartbeat-triggered election). Both objectives are read from one chart: lifetime should be as high as possible, orphan-ticks as low as possible. The lifetime curve has a sharp knee at $h\!\approx \!15$--$20$: from $h{=}1$ to $h{=}16$ lifetime jumps roughly $+240$ ticks; from $h{=}16$ to $h{=}150$ it gains only $\sim \!50$ more, while the worst-case failure-detection delay scales linearly with $h$. We therefore choose $h^\ast =15$: it captures $\sim \!95\%$ of the achievable lifetime while keeping the orphan window bounded at $\le 15$ ticks}{figure.caption.5}{}}
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Top six combinations (averaged over the 22 inputs, $d{=}5$, $h{=}15$, $a{=}$full, $r{=}0$) and the conventional baseline.}}{2}{table.caption.8}\protected@file@percent }
\newlabel{tab:summary}{{1}{2}{Top six combinations (averaged over the 22 inputs, $d{=}5$, $h{=}15$, $a{=}$full, $r{=}0$) and the conventional baseline}{table.caption.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Joint MOO Pareto plot.} $x$-axis: $\bar  M$ (lower is better). $y$-axis: $\bar  T_{\text  {all}}$ (higher is better). Colour = clustering algorithm, marker = election algorithm. The top-left frontier is the Pareto front. LEACH (red) sits in the top-left -- it dominates every other clustering on both objectives. Hybrid (purple) is the best deterministic policy. The conventional baseline ``highest-energy + Bully'' (orange circle) is the worst of all six clusterings.}}{3}{figure.caption.7}\protected@file@percent }
\newlabel{fig:pareto}{{2}{3}{\textbf {Joint MOO Pareto plot.} $x$-axis: $\bar M$ (lower is better). $y$-axis: $\bar T_{\text {all}}$ (higher is better). Colour = clustering algorithm, marker = election algorithm. The top-left frontier is the Pareto front. LEACH (red) sits in the top-left -- it dominates every other clustering on both objectives. Hybrid (purple) is the best deterministic policy. The conventional baseline ``highest-energy + Bully'' (orange circle) is the worst of all six clusterings}{figure.caption.7}{}}
